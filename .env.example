# DrakkarPress - Railway Environment Variables Template
# Copy these to Railway Dashboard → Variables, or use scripts/set-railway-env.ps1

# ============================================================
# DATABASE (Railway auto-provisions PostgreSQL)
# ============================================================
SPRING_DATASOURCE_URL=${DATABASE_URL}
SPRING_DATASOURCE_USERNAME=${PGUSER}
SPRING_DATASOURCE_PASSWORD=${PGPASSWORD}

# ============================================================
# JWT AUTHENTICATION
# ============================================================
JWT_SECRET=REEMPLAZAR_CON_CLAVE_SEGURA_256_BITS_MINIMO

# ============================================================
# STRIPE PAYMENTS
# ============================================================
STRIPE_API_KEY=sk_live_REEMPLAZAR_CON_TU_CLAVE_SECRETA
STRIPE_PUBLISHABLE_KEY=pk_live_REEMPLAZAR_CON_TU_CLAVE_PUBLICA
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZAR_CON_WEBHOOK_SECRET

# ============================================================
# FRONTEND URLs
# ============================================================
APP_FRONTEND_URL=https://REEMPLAZAR-CON-TU-NETLIFY.netlify.app
APP_FRONTEND_SUCCESS_URL=https://REEMPLAZAR-CON-TU-NETLIFY.netlify.app/checkout-success.html

# ============================================================
# SHOPIFY E-COMMERCE
# ============================================================
SHOPIFY_STORE_URL=https://REEMPLAZAR-CON-TU-TIENDA.myshopify.com
SHOPIFY_API_KEY=REEMPLAZAR_CON_API_KEY
SHOPIFY_API_SECRET=REEMPLAZAR_CON_API_SECRET
SHOPIFY_ACCESS_TOKEN=shpat_REEMPLAZAR_CON_ACCESS_TOKEN

# ============================================================
# LULU.COM PRINT-ON-DEMAND
# ============================================================
LULU_API_URL=https://api.lulu.com
LULU_API_KEY=REEMPLAZAR_CON_LULU_API_KEY
LULU_API_SECRET=REEMPLAZAR_CON_LULU_API_SECRET
LULU_SANDBOX=false

# ============================================================
# EMAIL (Gmail SMTP)
# ============================================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=REEMPLAZAR@gmail.com
SPRING_MAIL_PASSWORD=REEMPLAZAR_CON_APP_PASSWORD_GMAIL

# ============================================================
# OPTIONAL: OAuth2 (si se habilita en futuro)
# ============================================================
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=tu_google_client_id
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=tu_google_secret

# ============================================================
# NOTAS:
# ============================================================
# - DATABASE_URL, PGUSER, PGPASSWORD: Railway los provee automáticamente
# - JWT_SECRET: Generar con: openssl rand -base64 64
# - Gmail App Password: https://myaccount.google.com/apppasswords (requiere 2FA)
# - Stripe keys: https://dashboard.stripe.com/apikeys
# - Stripe webhook: https://dashboard.stripe.com/webhooks → Add endpoint
# - Shopify: Apps → Create app → API credentials
# - Lulu: Contactar soporte para obtener credenciales API
